# ============================================
# TikTok Content Engine - Environment Variables
# ============================================
# Copy this file to .env and fill in your values.

# --- LLM (Script Generation) ---
# Anthropic Claude API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Text-to-Speech ---
# Choose: "openai" or "elevenlabs"
TTS_PROVIDER=openai

# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-xxxxx
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=onyx

# ElevenLabs (optional, if TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- TikTok Content Posting API ---
# Register at https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
# Set to "true" to enable auto-posting, "false" for queue-only mode
TIKTOK_AUTO_POST=false

# --- Video Settings ---
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_BG_COLOR=#0a0a0a
FONT_PATH=assets/fonts/Montserrat-Bold.ttf
FONT_SIZE=64
SUBTITLE_FONT_SIZE=48

# --- Paths ---
CONTENT_DB_PATH=templates/content_calendar.csv
OUTPUT_DIR=output
LOGS_DIR=logs
ASSETS_DIR=assets

# --- Content Safety ---
# Topics containing these keywords get flagged for manual review
HIGH_RISK_KEYWORDS=cure,guaranteed,reverses,eliminates,permanent,miracle,clinical trial,diagnosis,prescribe,treatment plan,finasteride,dutasteride,hormone therapy
# Maximum retries for failed API calls
MAX_RETRIES=3
RETRY_DELAY_SECONDS=5
